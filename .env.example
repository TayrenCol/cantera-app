# ==========================================
# CONFIGURACIÓN DEL SERVIDOR NODE.JS
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# BASE DE DATOS MYSQL (HOSTINGER / LOCAL)
# ==========================================
# En Hostinger hPanel usar siempre 'localhost'
DB_HOST=localhost
DB_PORT=3306

# Reemplazar con las credenciales asignadas según el entorno:
# - Local/Dev: Datos de tu MySQL local o de la BD de desarrollo en Hostinger (u448206008_cantera_dev)
# - Prod: Inyectados directamente en el panel de Hostinger (u448206008_cantera_prod)
DB_USER=u448206008_tu_usuario
DB_PASSWORD=tu_contrasena_segura
DB_NAME=u448206008_tu_base_de_datos